#!/bin/bash
# Run a GUI app on the main PC and show it here via waypipe.
#   remote zen-browser      remote kitty      remote nautilus ~/Downloads
#
# Tailscale SSH creates forwarded unix sockets as root, so waypipe's built-in
# ssh mode cannot connect to them. Instead we forward a TCP port over ssh and
# bridge it to a unix socket with socat on the far side.
HOST="${REMOTE_HOST:-100.71.208.52}"
[ $# -gt 0 ] || { echo "usage: remote <app> [args]"; exit 1; }
# Firefox/zen: one process owns the profile and one process talks to one display,
# so close the instance on the main PC first; the remote one restores its session.
pre=""
case "$1" in
  zen-browser) pre='pkill -x zen-bin; while pgrep -x zen-bin >/dev/null; do sleep 0.2; done;' ;;
  firefox)     pre='pkill -x firefox; while pgrep -x firefox >/dev/null; do sleep 0.2; done;' ;;
esac

# DMABUF (GPU) surfaces are the slow path in waypipe: whole frames get re-encoded and
# browsers lag badly. --no-gpu makes the app render to shm, which waypipe diffs
# and sends only the damaged regions. REMOTE_GPU=1 keeps the GPU path for e.g. video.
OPTS=(--compress lz4)
SOPTS=()
[ -n "$REMOTE_GPU" ] && OPTS+=(--video h264) || SOPTS+=(--no-gpu)
port=$(shuf -i 20000-60000 -n 1)
sock="${XDG_RUNTIME_DIR:-/tmp}/waypipe-$port.sock"
rsock="/run/user/1000/waypipe-$port.sock"

waypipe "${OPTS[@]}" --title-prefix "[remote] " --socket "$sock" client &
cpid=$!
for _ in $(seq 50); do [ -S "$sock" ] && break; sleep 0.1; done
trap 'kill $cpid 2>/dev/null; rm -f "$sock"' EXIT

cmd=$(printf '%q ' "$@")
ssh -o ServerAliveInterval=15 -o ExitOnForwardFailure=yes \
    -R "127.0.0.1:$port:$sock" "shreyas@$HOST" \
    "$pre socat UNIX-LISTEN:$rsock,unlink-early,fork TCP:127.0.0.1:$port & sp=\$!; sleep 0.3; \
     waypipe ${OPTS[*]@Q} ${SOPTS[*]@Q} --unlink-socket --socket $rsock server -- $cmd; kill \$sp 2>/dev/null"
