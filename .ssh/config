# Main PC over Tailscale.  `ssh pc` gives a shell; on any machine other than the
# PC itself it also forwards localhost:5170-5179 (Vite and friends) to the PC, so
# a dev server there is reachable at the same localhost URL here.  The far end is
# "localhost", not 127.0.0.1: node/Vite often bind only [::1], and the PC resolves
# localhost to both loopbacks.
Host pc
    HostName 100.71.208.52
    User shreyas
    ServerAliveInterval 15
    # Reuse one connection for every `ssh pc`, so the forwards are bound once and
    # later shells attach instantly.  The master lingers 10 minutes after the last
    # shell exits, keeping the forwards alive between sessions.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

Match originalhost pc exec "[ \"$(uname -n)\" != shreyas ]"
    LocalForward 127.0.0.1:5170 localhost:5170
    LocalForward 127.0.0.1:5171 localhost:5171
    LocalForward 127.0.0.1:5172 localhost:5172
    LocalForward 127.0.0.1:5173 localhost:5173
    LocalForward 127.0.0.1:5174 localhost:5174
    LocalForward 127.0.0.1:5175 localhost:5175
    LocalForward 127.0.0.1:5176 localhost:5176
    LocalForward 127.0.0.1:5177 localhost:5177
    LocalForward 127.0.0.1:5178 localhost:5178
    LocalForward 127.0.0.1:5179 localhost:5179
    LocalForward 127.0.0.1:5179 localhost:5179
    LocalForward 127.0.0.1:3900 localhost:3900
    LocalForward 127.0.0.1:5716 localhost:5716
